{
  "schema_version": 1,
  "platform": "claude-code",
  "agent_format": "markdown_yaml_frontmatter",
  "project_agent_directory": ".claude/agents",
  "project_skill_directory": ".claude/skills",
  "user_agent_directory": ".claude/agents",
